{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node tests/theme-guard.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "node tests/theme-guard.mjs && tsc --noEmit",
    "test:payload": "tsx tests/payload.test.ts",
    "test:read": "node tests/run-reading.mjs",
    "test:answer": "tsx tests/answering.e2e.ts",
    "test": "npm run test:payload && npm run test:read && npm run test:answer && npm run test:newmenu && npm run test:quickanswer && npm run test:mobile && npm run test:back && npm run test:polish && npm run test:pdfedit && npm run test:pdfeditor && npm run test:theme && npm run test:mobileview && npm run test:billing",
    "test:newmenu": "node tests/newmenu.e2e.mjs",
    "test:quickanswer": "node tests/quickanswer.e2e.mjs",
    "icons": "node tests/make-icons.mjs",
    "test:mobile": "node tests/mobile.e2e.mjs",
    "test:back": "node tests/backdismiss.e2e.mjs",
    "fonts": "node tests/make-fonts.mjs",
    "test:polish": "node tests/polish.e2e.mjs",
    "test:pdfedit": "tsx tests/pdfedit.test.ts",
    "test:pdfeditor": "node tests/pdfeditor.e2e.mjs",
    "tokens": "node tests/make-tokens.mjs",
    "lint:theme": "node tests/theme-guard.mjs",
    "test:theme": "node tests/theme.e2e.mjs",
    "test:mobileview": "node tests/mobileview.e2e.mjs",
    "test:billing": "node tests/billing.e2e.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jspdf": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-pdf": "^10.4.1",
    "react-spreadsheet": "^0.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^3.2.29",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
