{
  "firestore": [
    {
      "database": "ai-studio-signal87ai-d3ac9818-22c6-408f-9f91-6cc2fa426bf0",
      "rules": "firestore.rules"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/health",
        "function": "health"
      },
      {
        "source": "/api/chat",
        "function": "chat"
      },
      {
        "source": "/api/research",
        "function": "research"
      },
      {
        "source": "/api/compare",
        "function": "compare"
      },
      {
        "source": "/api/analyze",
        "function": "analyze"
      },
      {
        "source": "/api/summarize",
        "function": "summarize"
      },
      {
        "source": "/api/documents/process",
        "function": "documentsProcess"
      },
      {
        "source": "/api/auth/welcome-email",
        "function": "authWelcomeEmail"
      },
      {
        "source": "/api/billing/plans",
        "function": "billingPlans"
      },
      {
        "source": "/api/billing/checkout",
        "function": "billingCheckout"
      },
      {
        "source": "/api/billing/portal",
        "function": "billingPortal"
      },
      {
        "source": "/api/billing/webhook",
        "function": "billingWebhook"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/team",
        "destination": "/team.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
