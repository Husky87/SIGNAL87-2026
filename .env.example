# Signal87 AI local environment configuration
# Copy this file to .env and replace placeholders with your real values.
# NEVER commit .env or real API keys to Git.

# Primary AI provider
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Gemini provider / default fallback model
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional Gemini aliases
# GOOGLE_GENERATIVE_AI_API_KEY="YOUR_GOOGLE_GENERATIVE_AI_API_KEY"
# GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"

# App URL
APP_URL="YOUR_APP_URL"

# Billing (server-side only). Match prices in the connected Stripe account.
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_PRICE_ID="YOUR_UNLIMITED_PRICE_ID"
# Optional legacy / 100-use plan price for existing paid account recognition.
STRIPE_PRICE_ID_100="YOUR_100_USE_PRICE_ID"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"
