# Signal87 AI local environment configuration
# Copy this file to .env and replace placeholders with your real values.
# NEVER commit .env or real API keys to Git.

# Primary AI provider
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Gemini provider / default chat model
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional Gemini aliases
# GOOGLE_GENERATIVE_AI_API_KEY="YOUR_GOOGLE_GENERATIVE_AI_API_KEY"
# GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"

# Optional Grok fallback
XAI_API_KEY="YOUR_XAI_API_KEY"

# App URL
APP_URL="YOUR_APP_URL"
